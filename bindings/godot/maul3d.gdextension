[configuration]
entry_symbol = "maul3d_library_init"
compatibility_minimum = "4.2"

[libraries]
linux.debug.x86_64 = "res://bin/libmaul3d_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmaul3d_godot.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/maul3d_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/maul3d_godot.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libmaul3d_godot.macos.template_debug.framework"
macos.release = "res://bin/libmaul3d_godot.macos.template_release.framework"
